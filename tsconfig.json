{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "types": ["vitest/globals"],
    "baseUrl": ".",
    "paths": {
      "@core/*": ["core/*"],
      "@capture/*": ["extension/src/content/capture/*"]
    }
  },
  "include": ["core/**/*.ts", "extension/src/**/*.ts", "extension/tests/**/*.ts"]
}
